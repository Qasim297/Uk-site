# ------------------------------------------------------------------
# AutoCheck Pro - environment variables
# Copy this file to `.env.local` and fill in real values.
# All of these are SERVER-SIDE ONLY. Never prefix secrets with NEXT_PUBLIC_.
# If DVSA and DVLA credentials are missing, the site shows clearly
# labelled DEMO DATA instead of real vehicle information.
# ------------------------------------------------------------------

# Public site URL (used for SEO metadata, sitemap and payment redirects)
NEXT_PUBLIC_SITE_URL=https://www.autocheckpro.co.uk

# --- DVSA MOT History API (https://documentation.history.mot.api.gov.uk/) ---
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
# Token URL issued with your credentials, e.g.
# https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
DVSA_TOKEN_URL=
DVSA_SCOPE=https://tapi.dvsa.gov.uk/.default
DVSA_API_BASE_URL=https://history.mot.api.gov.uk

# --- DVLA Vehicle Enquiry Service (tax status, Euro status, CO2) ---
# https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_VES_API_KEY=
DVLA_VES_API_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles

# --- Stripe payments (premium reports) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUNDLE=

# --- Contact form delivery (optional) ---
# Any HTTPS endpoint that accepts JSON (e.g. Zapier, Make, Formspree, your CRM)
CONTACT_WEBHOOK_URL=
